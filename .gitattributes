# The OpenAPI snapshot is a committed contract, regenerated by
# scripts/export_openapi.py and compared byte-for-byte by CI. The
# generator writes through Python's text layer, which translates newlines
# on Windows, so without this the drift check would report every line
# changed on a Windows runner. Pin it to LF and the answer stops
# depending on who ran it.
apps/backend/openapi.json text eol=lf
