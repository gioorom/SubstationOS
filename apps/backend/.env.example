# SubstationOS backend - environment variables.
#
# Copy this file to .env (already gitignored) and fill in real values
# for local development. Nothing here has a hardcoded fallback secret -
# missing values fail loudly at first use (see
# app/infrastructure/llm/anthropic/, docs/architecture/operational_reliability.md),
# never silently.

# Used only by the answering path, behind LlmProviderPort. The deterministic
# derivation pipeline - canonical representation through semantics - never reads
# it, and document upload triggers no model call. Leave it blank to run the whole
# pipeline with no AI provider configured.
# Missing this raises AIProviderError immediately - it is not read anywhere
# else and has no default.
ANTHROPIC_API_KEY=

# Optional. Overrides the Claude model used by the AI extraction path above.
# Defaults to claude-sonnet-4-20250514 if unset.
CLAUDE_MODEL=

# --- LLM Provider Abstraction Layer (Milestone 16, app/application/**) ---
# A separate, provider-neutral configuration surface for the governed
# EPIC 4 pipeline (POST /projects/{id}/llm/prepare-request) - unrelated to
# the legacy ANTHROPIC_API_KEY/CLAUDE_MODEL variables above. No API key
# is read here: this milestone only prepares a request, it never invokes
# a provider. See docs/architecture/llm_provider_abstraction.md.

# Optional. Which registered provider adapter to use by default when an
# API caller does not supply one explicitly. Defaults to "anthropic".
LLM_PROVIDER=

# Optional but has NO hardcoded fallback of any kind - unlike CLAUDE_MODEL
# above, no Claude Opus/Sonnet version or any other model name is ever
# assumed. Leaving this unset means every request-preparation call must
# supply its own model_identifier explicitly, or it is rejected as an
# invalid model selection.
LLM_MODEL=

# Optional. Falls back to 4096 if unset.
LLM_DEFAULT_MAX_OUTPUT_TOKENS=

# Optional. No default generation temperature is applied unless set.
LLM_TEMPERATURE=

# --- LLM Invocation Runtime (Milestone 17, app/application/services/llm_runtime.py) ---
# Governs whether POST /projects/{id}/llm/invoke may perform a real
# provider call at all. This is this codebase's first external data
# boundary: enabling it means enabled PromptPackage content leaves the
# process and reaches whichever provider is configured, whenever a
# credential is also present. See docs/architecture/llm_invocation_runtime.md.
#
# Reuses ANTHROPIC_API_KEY above as the Anthropic credential - the same
# variable the legacy claude_provider.py already reads. There is no
# second, invocation-specific API key variable.

# Optional. Defaults to "false" - real invocation is disabled unless
# explicitly turned on. Never defaults to enabled.
LLM_RUNTIME_ENABLED=

# Optional. Per-call connect timeout, in seconds. Defaults to 5.0.
LLM_CONNECT_TIMEOUT_SECONDS=

# Optional. Per-call read timeout, in seconds. Defaults to 60.0.
LLM_READ_TIMEOUT_SECONDS=

# Optional. Total invocation deadline, in seconds, covering every
# attempt and every retry delay combined - not a per-call timeout.
# Defaults to 90.0.
LLM_TOTAL_TIMEOUT_SECONDS=

# Optional. Maximum number of provider-call attempts for one invocation
# (the first call plus retries). Defaults to 3.
LLM_MAX_ATTEMPTS=

# Optional. Base delay, in seconds, for exponential retry backoff.
# Defaults to 1.0.
LLM_RETRY_BASE_DELAY_SECONDS=

# Optional. Upper bound, in seconds, any single retry delay is capped
# at, regardless of the provider's own Retry-After hint. Defaults to 20.0.
LLM_RETRY_MAX_DELAY_SECONDS=

# Optional. Whether retry delays are jittered (+/-20%). Defaults to
# "true"; set to "false" only for exact, non-jittered delay reproduction.
LLM_RETRY_JITTER_ENABLED=

# Optional, Alembic-only (see migrations/env.py). Overrides the database
# Alembic migrates for a single invocation - lets you point migrations at a
# scratch/throwaway database without touching the real one or editing code.
# Never read by the running application itself (app/database/database.py's
# DATABASE_URL is not affected by this variable) - unset it for normal use.
SUBSTATIONOS_DATABASE_URL=
